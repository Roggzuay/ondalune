<?xml version="1.0" encoding="utf-8"?>
<!--
  Player widget. The card behind everything (widget_bg_image) is rendered at the widget's real
  size: a soft blur of the current cover under a tonal scrim, matching the in-app player.
  Expanded: track row + progress + centred transport. Compact: transport sits inline.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_preview_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_preview_art"
                android:contentDescription="@string/now_playing" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="All Caps"
                    android:textColor="#FFF6F4FF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Madvillain"
                    android:textColor="#FFD0CDE0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_badge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Paused · FLAC"
                    android:textColor="#FFA8C7FA"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Compact presentation: transport inline with the track -->
            <LinearLayout
                android:id="@+id/widget_compact_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/widget_btn_prev_compact"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Previous track"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_prev" />

                <ImageButton
                    android:id="@+id/widget_btn_play_compact"
                    android:src="@drawable/widget_preview_play"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Play or pause"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/widget_btn_next_compact"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Next track"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_next" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/widget_btn_star"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Favourite"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_heart_outline" />
        </LinearLayout>

        <!-- Tall widgets: fills the middle (lyrics when available) and pushes the transport to the bottom edge -->
        <FrameLayout
            android:id="@+id/widget_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/widget_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_lyric_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingMultiplier="1.05"
                    android:maxLines="3"
                    android:text="Lyric line"
                    android:textColor="#FFF6F4FF"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/widget_lyric_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:text="Next line"
                    android:textColor="#A6D0CDE0"
                    android:textSize="17sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_controls_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginEnd="4dp"
                android:max="1000"
                android:progress="350"
                android:progressBackgroundTint="#33FFFFFF"
                android:progressTint="#FFA8C7FA" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="0:01"
                    android:textColor="#FFD0CDE0"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Previous track"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_prev" />

                <ImageButton
                    android:id="@+id/widget_btn_play_pause"
                    android:src="@drawable/widget_preview_play"
                    android:layout_width="60dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Play or pause"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/widget_btn_next"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Next track"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_next" />

                <TextView
                    android:id="@+id/widget_time_total"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:maxLines="1"
                    android:paddingEnd="4dp"
                    android:text="2:10"
                    android:textColor="#FFD0CDE0"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
