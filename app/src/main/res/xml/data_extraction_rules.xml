<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: same policy as backup_rules.xml, for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="ondalune_offline_downloads/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="ondalune_offline_downloads/" />
    </device-transfer>
</data-extraction-rules>
