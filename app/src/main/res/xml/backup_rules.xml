<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Settings are backed up; the server database is not (its saved
     passwords are encrypted with a key that never leaves the device, so a restored copy could
     not be read), and neither are offline downloads, which are large and re-downloadable. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="ondalune_offline_downloads/" />
</full-backup-content>
